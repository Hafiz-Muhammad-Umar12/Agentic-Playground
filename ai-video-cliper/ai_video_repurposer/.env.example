# ─── App Config ──────────────────────────────────────────────
APP_NAME="AI Video Repurposer PRO"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
API_V1_STR=/api/v1

# ─── Database ────────────────────────────────────────────────
# DATABASE
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/video_repurposer
SYNC_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/video_repurposer
# ─── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── AI APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Storage (Cloudinary) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Publishing APIs (Premium) ───────────────────────────────
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret

# ─── Deepgram (Alternative Transcription) ────────────────────
DEEPGRAM_API_KEY=your-deepgram-key

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_PUBLISHING=false
ENABLE_FACE_TRACKING=false
MAX_VIDEO_DURATION_MINUTES=120
MAX_CLIPS_PER_JOB=10
STORAGE_PROVIDER=cloudinary  # local or cloudinary
FFMPEG_PATH=C:\ffmpeg\bin
YT_DLP_COOKIES_PATH=C:\path\to\cookies.txt
